# .editorconfig_raptor — stricter variant for comparison with the project's .editorconfig
# Purpose: Enforce stricter, Copilot/CICD-friendly rules for LiteDB.Studio.Wpf.
# This file is intentionally more prescriptive than the project's .editorconfig to
# help validate code generation and automated formatting in a CI pipeline.
# Compare this with .editorconfig to see where rules are tightened.

root = true

################################################################################
# C# file settings
# - These rules apply to all C# source files and make the project style stricter
#   for automated checks and Copilot code generation.
################################################################################
[*.cs]

# ----------------------------- Basic formatting -----------------------------
# Indentation, line endings and character set
# - indent_style / indent_size: 4 spaces to match the project's convention
# - end_of_line: CRLF for Windows development
# - insert_final_newline: require a final newline for consistency
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
insert_final_newline = true
charset = utf-8

# ------------------------ Accessibility & explicitness ----------------------
# Require explicit accessibility modifiers on non-interface members to make
# the code intent clear and to avoid accidental internal/public exposure.
# Severity: error to fail CI on violations.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# --------------------------------- Usings ----------------------------------
# Prefer separate directive groups and System first, and place 'using'
# directives outside the namespace to reduce nesting and match style.
# These are set to error to enforce consistency across generated code.
dotnet_separate_import_directive_groups = true:error
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:error

# --------------------------- Namespace declarations -------------------------
# Prefer file-scoped namespaces to reduce indentation and modernize files.
csharp_style_namespace_declarations = file_scoped:error

# ------------------------- Member qualification ----------------------------
# Disallow unnecessary 'this.' qualification for fields/properties/methods/events
# to keep code concise and match the project's conventions.
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# ----------------------------- 'var' preferences ---------------------------
# Enforce clearer 'var' usage:
# - allow var for built-in types (int, string, etc.)
# - disallow var in less obvious situations to improve readability
csharp_style_var_for_built_in_types = true:error
csharp_style_var_elsewhere = false:error
csharp_style_var_when_type_is_apparent = true:warning

# -------------------------- Braces and block style -------------------------
# Enforce braces for all control blocks and use Allman style (open brace on new line)
csharp_prefer_braces = true:error
csharp_new_line_before_open_brace = all

# ----------------------- Expression-bodied members -------------------------
# Prefer block bodies for methods (more room for future edits),
# but allow expression-bodied properties for simple getters.
csharp_style_expression_bodied_methods = when_on_single_line:none
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_ctors = false:error

# ----------------------- Null checks & pattern matching --------------------
# Prefer pattern matching and 'is null' checks for clarity and correctness.
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error
csharp_style_prefer_pattern_matching = true:suggestion

# -------------------------------- Readonly --------------------------------
# Encourage readonly fields for immutability where appropriate.
dotnet_style_readonly_field = true:warning

# ------------------------ Predefined type usage ----------------------------
# Prefer C# built-in type keywords (int, string) for locals/params/members.
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# ----------------------------- Naming rules --------------------------------
# Enforce common naming rules to keep generated code predictable and consistent.

# Interfaces must begin with 'I'
dotnet_naming_rule.interface_should_begin_with_i.severity = error
dotnet_naming_rule.interface_should_begin_with_i.symbols = interface
dotnet_naming_rule.interface_should_begin_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Types should be PascalCase
dotnet_naming_rule.types_should_be_pascal_case.severity = error
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Non-field members (properties, methods, events) should be PascalCase
dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = error
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method

# -------------------------- Other stylistic rules --------------------------
# Suggestions for modern C# features and small style preferences.
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# ---------------------------- File header policy --------------------------
# Leave file header unset to avoid enforcing a specific header in generated files.
file_header_template = unset:none

# ---------------------- Experimental allowances ----------------------------
# Keep experimental allowances conservative to avoid noisy diagnostics.
dotnet_style_allow_multiple_blank_lines_experimental = false:silent

# End of file

