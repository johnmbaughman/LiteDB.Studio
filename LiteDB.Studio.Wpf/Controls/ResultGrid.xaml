<UserControl
    x:Class="LiteDB.Studio.Wpf.Controls.ResultGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Thin grid cell style: lighter, thinner borders and modest padding -->
        <Style x:Key="DataGridCellThinBorderStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush" Value="#FFDDDDDD" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!--  Row header style that removes the resize thumb and prevents resize cursor  -->
        <Style x:Key="DataGridRowHeaderNoResizeStyle" TargetType="DataGridRowHeader">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRowHeader">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Padding="5"
            Background="Yellow"
            Text="Warning: Results limited to 1000 rows"
            Visibility="{Binding QueryResult.LimitExceeded, Converter={StaticResource BoolToVis}}" />
        <DataGrid
            x:Name="ResultsDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserResizeRows="False"
            IsReadOnly="False"
            ItemsSource="{Binding QueryResult.Rows}"
            LoadingRow="ResultsDataGrid_LoadingRow"
            RowHeaderStyle="{StaticResource DataGridRowHeaderNoResizeStyle}"
            RowHeaderWidth="40"
            SelectionMode="Extended"
            SelectionUnit="CellOrRowHeader"
            VirtualizingStackPanel.IsVirtualizing="True"
            CellStyle="{StaticResource DataGridCellThinBorderStyle}"
            GridLinesVisibility="Vertical"
            VerticalGridLinesBrush="#FFDDDDDD"
            HorizontalGridLinesBrush="#FFEEEEEE"
            BorderThickness="0.5"
            BorderBrush="#FFDDDDDD" />
    </Grid>
</UserControl>