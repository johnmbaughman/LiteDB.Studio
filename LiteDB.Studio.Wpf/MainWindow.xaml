<Window x:Class="LiteDB.Studio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:LiteDB.Studio.Wpf.ViewModels"
        xmlns:svc="clr-namespace:LiteDB.Studio.Wpf.Services"
        xmlns:util="clr-namespace:LiteDB.Studio.Wpf.Util"
        xmlns:controls="clr-namespace:LiteDB.Studio.Wpf.Controls"
        xmlns:views="clr-namespace:LiteDB.Studio.Wpf.Views"
        mc:Ignorable="d"
        Title="LiteDB Studio (WPF)" Height="600" Width="900"
        Icon="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/litedb_icon.png">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <util:PathTrimmerConverter x:Key="PathTrimmer" StartCounter="28" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" DockPanel.Dock="Top" Background="#FFF6F6F6">
            <!-- Toolbar-only header to mimic WinForms layout -->
            <Grid DockPanel.Dock="Top" Height="36" Background="#FFF6F6F6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToolBarTray Grid.Column="0" VerticalAlignment="Center" Background="#FFF6F6F6" Margin="0">
                    <ToolBar Padding="2,0" Background="#FFF6F6F6" BorderBrush="Transparent">
                        <!-- Recent databases dropdown (small icon) -->
                        <Menu Background="Transparent">
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/recent_dbs.png" Margin="0,0,6,0" />
                                        <TextBlock Text="▾" FontSize="12" VerticalAlignment="Center" Foreground="Gray" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Command="{x:Null}">
                                    <MenuItem.Header>Settings</MenuItem.Header>
                                    <MenuItem Header="Clear Recent List" Command="{Binding ClearRecentCommand}" />
                                    <MenuItem Header="Validate Recent List" Command="{Binding ValidateRecentCommand}" />
                                </MenuItem>
                                <Separator />
                                <!-- Recent items in their own submenu so style only applies to bound items -->
                                <MenuItem Header="Recent" Command="{x:Null}">
                                    <MenuItem.ItemsSource>
                                        <Binding Path="RecentDatabases" />
                                    </MenuItem.ItemsSource>
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Converter={StaticResource PathTrimmer}}" />
                                            <Setter Property="ToolTip" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentWrapperCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </MenuItem>
                        </Menu>

                        <!-- Connect button with icon + text -->
                        <Button Command="{Binding ConnectCommand}" ToolTip="Connect" Margin="6,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_connect.png" Margin="0,0,6,0" />
                                <TextBlock Text="Connect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button ToolTip="Refresh" Margin="0,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/arrow_refresh.png" />
                                <TextBlock Text="Refresh" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RunCommand}" ToolTip="Run" Margin="0,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/resultset_next.png" />
                                <TextBlock Text="Run" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Load" Margin="6,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/folder_page.png" />
                                <TextBlock Text="Load" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Save" Margin="0,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/disk.png" />
                                <TextBlock Text="Save" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Begin" Margin="6,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database.png" />
                                <TextBlock Text="Begin" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Commit" Margin="0,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_save.png" />
                                <TextBlock Text="Commit" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button ToolTip="Rollback" Margin="0,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_delete.png" />
                                <TextBlock Text="Rollback" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Checkpoint" Margin="6,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/application_put.png" />
                                <TextBlock Text="Checkpoint" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Debug" Margin="0,0,6,0" IsEnabled="{Binding IsConnected}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/bug_link.png" />
                                <TextBlock Text="Debug" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Load last DB" Margin="0,0,6,0" Click="LoadLastDb_Click">
                            <util:GrayableImage Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/load_last_db.png" />
                        </Button>
                    </ToolBar>
                </ToolBarTray>

                <!-- Right aligned checkbox -->
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,0" Background="#FFF6F6F6">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding LoadLastDatabaseOnStartup}" Content="Load last database on startup" />
                </Border>
            </Grid>
        </DockPanel>
        <views:DatabaseTreeView Grid.Row="1" Grid.Column="0" Margin="4" DataContext="{Binding Tree}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
        <!-- Splitter between tree and editor -->
        <GridSplitter Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Background="#FFECECEC" ShowsPreview="True" />

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <TabControl x:Name="QueryTabs" Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        VirtualizingPanel.IsVirtualizing="False" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Margin="4,0" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type local:TabViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>
                            <avalon:TextEditor Grid.Row="0" x:Name="QueryEditor" ShowLineNumbers="True"
                                                   controls:AvalonEditBehaviors.EditorText="{Binding EditorText, Mode=TwoWay}"
                                                   controls:AvalonEditBehaviors.CaretOffset="{Binding CaretOffset, Mode=TwoWay}"
                                                   controls:AvalonEditBehaviors.SelectionStart="{Binding SelectionStart, Mode=TwoWay}"
                                                   controls:AvalonEditBehaviors.SelectionLength="{Binding SelectionLength, Mode=TwoWay}"
                                                   controls:AvalonEditBehaviors.IsModified="{Binding IsModified, Mode=TwoWay}"
                                                   controls:AvalonEditBehaviors.ShowCompletionCommand="{Binding ShowCompletionCommand}"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch" />

                            <!-- Splitter between editor and results (placed at parent grid row 1) -->
                            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="6" ShowsPreview="True" Background="#FFECECEC" />

                            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedResultTabIndex, Mode=TwoWay}">
                                <TabItem Header="Grid">
                                    <controls:ResultGrid DataContext="{Binding ResultGridViewModel}" />
                                </TabItem>
                                <TabItem Header="Text">
                                    <controls:ResultTextView QueryResult="{Binding LastResult}" />
                                </TabItem>
                                <TabItem Header="Parameters">
                                    <controls:ParametersView />
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <StatusBar Grid.Row="2">
                <StatusBarItem Content="Ready" />
                <StatusBarItem>
                    <TextBlock Text="{Binding CursorText}" />
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding ElapsedText}" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
