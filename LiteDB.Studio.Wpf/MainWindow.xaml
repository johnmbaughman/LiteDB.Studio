<Window x:Class="LiteDB.Studio.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:LiteDB.Studio.Wpf.ViewModels"
        xmlns:svc="clr-namespace:LiteDB.Studio.Wpf.Services"
        xmlns:util="clr-namespace:LiteDB.Studio.Wpf.Util"
        mc:Ignorable="d"
        Title="LiteDB Studio (WPF)" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <util:PathTrimmerConverter x:Key="PathTrimmer" StartCounter="28" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" DockPanel.Dock="Top" Background="#FFF6F6F6">
            <!-- Toolbar-only header to mimic WinForms layout -->
            <Grid DockPanel.Dock="Top" Height="36" Background="#FFF6F6F6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToolBarTray Grid.Column="0" VerticalAlignment="Center" Background="#FFF6F6F6" Margin="0">
                    <ToolBar Padding="2,0" Background="#FFF6F6F6" BorderBrush="Transparent">
                        <!-- Recent databases dropdown (small icon) -->
                        <Menu Background="Transparent">
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image Width="10" Height="10" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/application_put.png" Margin="0,0,6,0" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Command="{x:Null}">
                                    <MenuItem.Header>Settings</MenuItem.Header>
                                    <MenuItem Header="Clear Recent List" Command="{Binding ClearRecentCommand}" />
                                    <MenuItem Header="Validate Recent List" Command="{Binding ValidateRecentCommand}" />
                                </MenuItem>
                                <Separator />
                                <!-- Recent items in their own submenu so style only applies to bound items -->
                                <MenuItem Header="Recent" Command="{x:Null}">
                                    <MenuItem.ItemsSource>
                                        <Binding Path="RecentDatabases" />
                                    </MenuItem.ItemsSource>
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Converter={StaticResource PathTrimmer}}" />
                                            <Setter Property="ToolTip" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentWrapperCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </MenuItem>
                        </Menu>

                        <!-- Connect button with icon + text -->
                        <Button Command="{Binding ConnectCommand}" ToolTip="Connect" Margin="6,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_connect.png" Margin="0,0,6,0" />
                                <TextBlock Text="Connect" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button ToolTip="Refresh" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/arrow_refresh.png" />
                                <TextBlock Text="" Width="6" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding RunCommand}" ToolTip="Run" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/lightning.png" />
                                <TextBlock Text="" Width="6" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Load" Margin="6,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/folder_page.png" />
                        </Button>
                        <Button ToolTip="Save" Margin="0,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/table_save.png" />
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Begin" Margin="6,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/page_white_gear.png" />
                        </Button>
                        <Button ToolTip="Commit" Margin="0,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/disk.png" />
                        </Button>
                        <Button ToolTip="Rollback" Margin="0,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_delete.png" />
                        </Button>

                        <Separator Margin="6,0" />

                        <Button ToolTip="Checkpoint" Margin="6,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/resultset_next.png" />
                        </Button>
                        <Button ToolTip="Debug" Margin="0,0,6,0">
                            <Image Width="16" Height="16" Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/bug_link.png" />
                        </Button>
                    </ToolBar>
                </ToolBarTray>

                <!-- Right aligned checkbox -->
                <Border Grid.Column="1" VerticalAlignment="Center" Padding="8,0" Background="#FFF6F6F6">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding LoadLastDatabaseOnStartup}" Content="Load last database on startup" />
                </Border>
            </Grid>
        </DockPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Recent Databases" FontWeight="Bold" Margin="0,0,0,4" />
            <ListBox ItemsSource="{Binding RecentDatabases}" Width="240" SelectedItem="{Binding SelectedRecent}" />
            <Separator Margin="0,6" />
            <TreeView x:Name="DbTree" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="150" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <TabControl x:Name="QueryTabs" Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        VirtualizingPanel.IsVirtualizing="False" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Margin="4,0" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type local:TabViewModel}">
                        <avalon:TextEditor ShowLineNumbers="True"
                                           Loaded="OnTabEditorLoaded"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <DataGrid Grid.Row="2" ItemsSource="{Binding CurrentResults.DefaultView}" AutoGenerateColumns="True" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />

            <StatusBar Grid.Row="3">
                <StatusBarItem Content="Ready" />
                <StatusBarItem>
                    <TextBlock Text="{Binding CursorText}" />
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding ElapsedText}" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
