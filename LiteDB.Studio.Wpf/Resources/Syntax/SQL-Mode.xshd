<SyntaxDefinition name="SQL" extensions=".sql">
  <Environment>
    <LineNumbers color="Gray"/>
  </Environment>
  <Properties>
    <Property name="LineComment" value="--"/>
  </Properties>
  <Digits name="Digits" bold="true" italic="false" color="Black"/>
  <RuleSets>
    <RuleSet ignorecase="true">
      <Delimiters>&amp;&lt;&gt;~!%^*()-+=|\#/{}[]:;"' ,	.?</Delimiters>
      
      <Span name="String" bold="false" italic="false" color="Red" stopateol="false">
        <Begin>'</Begin>
        <End>'</End>
      </Span>
      
      <Span name="String2" bold="false" italic="false" color="Red" stopateol="false">
        <Begin>"</Begin>
        <End>"</End>
      </Span>

      <Span name="LineComment" bold="false" italic="false" color="Green" stopateol="true">
        <Begin>--</Begin>
      </Span>
      
      <KeyWords name="ComparisonKeywords" bold="false" italic="false" color="Gray">
        <Key word="$" />
        <Key word="@" />
        <Key word="AND" />
        <Key word="OR" />
        <Key word="LIKE" />
        <Key word="BETWEEN" />
        <Key word="IN" />
        <Key word="+" />
        <Key word="-" />
        <Key word="*" />
        <Key word="/" />
        <Key word="=" />
        <Key word="&lt;" />
        <Key word="&gt;" />
        <Key word="&lt;=" />
        <Key word="&gt;=" />
        <Key word="%" />
        <Key word=";" />
      </KeyWords>
      
      <KeyWords name="ValueKeywords" bold="false" italic="false" color="Gray">
        <Key word="TRUE" />
        <Key word="FALSE" />
        <Key word="NULL" />
      </KeyWords>

      <KeyWords name="SqlKeywordsNormal" bold="false" italic="false" color="Blue">
        <Key word="BEGIN" />
        <Key word="COMMIT" />
        <Key word="ROLLBACK" />
        <Key word="TRANS" />
        <Key word="TRANSACTION" />
        <Key word="ANALYZE" />
        <Key word="CHECKPOINT" />
        <Key word="REBUILD" />
        <Key word="PRAGMA" />
        <Key word="CREATE" />
        <Key word="INDEX" />
        <Key word="ON" />
        <Key word="UNIQUE" />
        <Key word="DELETE" />
        <Key word="DROP" />
        <Key word="COLLECTION" />
        <Key word="RENAME" />
        <Key word="TO" />
        <Key word="INSERT" />
        <Key word="INTO" />
        <Key word="VALUES" />
        <Key word="SELECT" />
        <Key word="ALL" />
        <Key word="FULL" />
        <Key word="FROM" />
        <Key word="WHERE" />
        <Key word="INCLUDE" />
        <Key word="GROUP" />
        <Key word="ORDER" />
        <Key word="BY" />
        <Key word="AS" />
        <Key word="ASC" />
        <Key word="DESC" />
        <Key word="HAVING" />
        <Key word="LIMIT" />
        <Key word="OFFSET" />
        <Key word="FOR" />
        <Key word="SET" />
        <Key word="EXPLAIN" />
        <Key word="UPDATE" />
        <Key word="REPLACE" />
        <Key word="VACCUM" />
        <Key word="CHECK" />
        <Key word="MAP" />
        <Key word="FILTER" />
        <Key word="SORT" />
      </KeyWords>
      
      <KeyWords name="SqlMethods" bold="false" italic="false" color="Fuchsia">
        <Key word="USER_VERSION" />
        <Key word="COLLATION" />
        <Key word="TIMEOUT" />
        <Key word="LIMIT_SIZE" />
        <Key word="UTC_DATE" />
        <Key word="CHECKPOINT" />
        <Key word="COUNT" />
        <Key word="MIN" />
        <Key word="MAX" />
        <Key word="FIRST" />
        <Key word="LAST" />
        <Key word="AVG" />
        <Key word="SUM" />
        <Key word="ANY" />
        <Key word="JOIN" />
        <Key word="MINVALUE" />
        <Key word="OBJECTID" />
        <Key word="GUID" />
        <Key word="NOW" />
        <Key word="NOW_UTC" />
        <Key word="TODAY" />
        <Key word="MAXVALUE" />
        <Key word="INT32" />
        <Key word="INT" />
        <Key word="INT64" />
        <Key word="LONG" />
        <Key word="DOUBLE" />
        <Key word="DECIMAL" />
        <Key word="STRING" />
        <Key word="ARRAY" />
        <Key word="BINARY" />
        <Key word="BOOLEAN" />
        <Key word="BOOL" />
        <Key word="DATETIME" />
        <Key word="DATETIME_UTC" />
        <Key word="DATE" />
        <Key word="DATE_UTC" />
      </KeyWords>
      
    </RuleSet>
  </RuleSets>
</SyntaxDefinition>