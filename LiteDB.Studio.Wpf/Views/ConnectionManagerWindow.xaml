<Window
    x:Class="LiteDB.Studio.Wpf.Views.ConnectionManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:util="clr-namespace:LiteDB.Studio.Wpf.Util"
    Title="Connection Manager"
    Width="612"
    Height="474"
    util:WindowCloseBehavior.CloseTrigger="{Binding CloseTrigger}"
    FontFamily="Segoe UI"
    FontSize="9"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <util:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </Window.Resources>
    <Canvas>
        <!--  match WinForms absolute placement and sizes  -->
        <GroupBox
            Canvas.Left="12"
            Canvas.Top="11"
            Width="569"
            Height="60"
            Header="Connection Mode">
            <Canvas>
                <RadioButton
                    Canvas.Left="30"
                    Canvas.Top="25"
                    Content="Direct"
                    IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Direct}" />
                <RadioButton
                    Canvas.Left="151"
                    Canvas.Top="25"
                    Content="Shared"
                    IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Shared}" />
            </Canvas>
        </GroupBox>

        <GroupBox
            Canvas.Left="12"
            Canvas.Top="81"
            Width="569"
            Height="72"
            Header="Filename">
            <Canvas>
                <TextBox
                    x:Name="FilenameBox"
                    Canvas.Left="19"
                    Canvas.Top="28"
                    Width="502"
                    Height="27"
                    Text="{Binding Filename}" />
                <Button
                    x:Name="BtnOpen"
                    Canvas.Left="527"
                    Canvas.Top="28"
                    Width="28"
                    Height="24"
                    Command="{Binding BrowseCommand}">
                    <Image
                        Width="16"
                        Height="16"
                        Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/folder_explore.png" />
                </Button>
            </Canvas>
        </GroupBox>

        <GroupBox
            Canvas.Left="12"
            Canvas.Top="159"
            Width="569"
            Height="209"
            Header="Parameters">
            <Canvas>
                <Label
                    Canvas.Left="18"
                    Canvas.Top="25"
                    Content="Password:" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Canvas.Left="151"
                    Canvas.Top="22"
                    Width="404"
                    Height="27"
                    util:PasswordBoxBehavior.BoundPassword="{Binding Password}" />

                <Label
                    Canvas.Left="18"
                    Canvas.Top="64"
                    Content="Initial Size (MB):" />
                <TextBox
                    x:Name="txtInitialSize"
                    Canvas.Left="151"
                    Canvas.Top="61"
                    Width="70"
                    Height="27"
                    Text="{Binding InitialSize}"
                    TextAlignment="Center" />

                <Label
                    Canvas.Left="18"
                    Canvas.Top="103"
                    Content="Collation:" />
                <ComboBox
                    x:Name="cmbCulture"
                    Canvas.Left="151"
                    Canvas.Top="100"
                    Width="117"
                    Height="28"
                    IsEditable="False" />
                <Label
                    Canvas.Left="274"
                    Canvas.Top="103"
                    Content="/" />
                <ComboBox
                    x:Name="cmbSort"
                    Canvas.Left="292"
                    Canvas.Top="100"
                    Width="117"
                    Height="28"
                    IsEditable="False" />

                <CheckBox
                    x:Name="chkReadonly"
                    Canvas.Left="21"
                    Canvas.Top="139"
                    Content="Read only" />
                <CheckBox
                    x:Name="chkUpgrade"
                    Canvas.Left="21"
                    Canvas.Top="175"
                    Content="Upgrade from LiteDB v4 (if needed)" />
            </Canvas>
        </GroupBox>

        <Button
            x:Name="btnOK"
            Canvas.Left="454"
            Canvas.Top="383"
            Width="127"
            Height="38"
            Padding="10,0,0,0"
            Command="{Binding ConnectCommand}"
            FontWeight="Bold">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_connect.png" />
                <TextBlock VerticalAlignment="Center" Text="Connect" />
            </StackPanel>
        </Button>
    </Canvas>
</Window>
