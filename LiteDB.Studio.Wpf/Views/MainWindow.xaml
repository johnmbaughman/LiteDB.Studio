<UserControl
    x:Class="LiteDB.Studio.Wpf.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:behaviors="clr-namespace:LiteDB.Studio.Wpf.Behaviors"
    xmlns:controls="clr-namespace:LiteDB.Studio.Wpf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiteDB.Studio.Wpf.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:util="clr-namespace:LiteDB.Studio.Wpf.Util"
    MinWidth="900"
    MinHeight="600"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    behaviors:SqlHighlightingBehavior.EnableSqlHighlighting="True"
    d:DataContext="{d:DesignInstance}"
    mc:Ignorable="d">

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
    </UserControl.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <util:PathTrimmerConverter x:Key="PathTrimmer" StartCounter="28" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#FFF6F6F6"
            DockPanel.Dock="Top">
            <!--  Toolbar-only header to mimic WinForms layout  -->
            <Grid
                Height="36"
                Background="#FFF6F6F6"
                DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToolBarTray
                    Grid.Column="0"
                    Margin="0"
                    VerticalAlignment="Center"
                    Background="#FFF6F6F6">
                    <ToolBar
                        Padding="2,0"
                        Background="#FFF6F6F6"
                        BorderBrush="Transparent">
                        <!--  Recent databases dropdown (small icon)  -->
                        <Menu Background="Transparent">
                            <MenuItem>
                                <MenuItem.Header>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <util:GrayableImage
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/recent_dbs.png" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="Gray"
                                            Text="▾" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Command="{x:Null}">
                                    <MenuItem.Header>Settings</MenuItem.Header>
                                    <MenuItem Command="{Binding ClearRecentCommand}" Header="Clear Recent List" />
                                    <MenuItem Command="{Binding ValidateRecentCommand}" Header="Validate Recent List" />
                                </MenuItem>
                                <Separator />
                                <!--  Recent items in their own submenu so style only applies to bound items  -->
                                <MenuItem Command="{x:Null}" Header="Recent">
                                    <MenuItem.ItemsSource>
                                        <Binding Path="RecentDatabases" />
                                    </MenuItem.ItemsSource>
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Converter={StaticResource PathTrimmer}}" />
                                            <Setter Property="ToolTip" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentWrapperCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </MenuItem>
                        </Menu>

                        <!--  Connect button with icon + text  -->
                        <Button
                            Margin="6,0,12,0"
                            Command="{Binding ConnectCommand}"
                            ToolTip="Connect">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_connect.png" />
                                <TextBlock VerticalAlignment="Center" Text="Connect" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Refresh">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/arrow_refresh.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Refresh" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,6,0"
                            Command="{Binding RunCommand}"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Run">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/resultset_next.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Run" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button
                            Margin="6,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Load">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/folder_page.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Load" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Save">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/disk.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Save" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button
                            Margin="6,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Begin">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Begin" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Commit">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_save.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Commit" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Rollback">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/database_delete.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Rollback" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button
                            Margin="6,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Checkpoint">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/application_put.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Checkpoint" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button
                            Margin="0,0,6,0"
                            IsEnabled="{Binding IsConnected}"
                            ToolTip="Debug">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <util:GrayableImage
                                    Width="16"
                                    Height="16"
                                    Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/bug_link.png" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Debug" />
                            </StackPanel>
                        </Button>

                        <Separator Margin="6,0" />

                        <Button
                            Margin="0,0,6,0"
                            Command="{Binding LoadLastDatabaseCommand}"
                            ToolTip="Load last DB">
                            <util:GrayableImage
                                Width="16"
                                Height="16"
                                Source="pack://application:,,,/LiteDB.Studio.Wpf;component/Resources/load_last_db.png" />
                        </Button>
                    </ToolBar>
                </ToolBarTray>

                <!--  Right aligned checkbox  -->
                <Border
                    Grid.Column="1"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    Background="#FFF6F6F6">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="Load last database on startup"
                        IsChecked="{Binding LoadLastDatabaseOnStartup}" />
                </Border>
            </Grid>
        </DockPanel>
        <ContentControl
            x:Name="DatabaseTreeViewHost"
            Grid.Row="1"
            Grid.Column="0"
            Margin="4"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
        <!--  Splitter between tree and editor  -->
        <GridSplitter
            Grid.Row="1"
            Grid.Column="0"
            Width="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="#FFECECEC"
            ShowsPreview="True" />

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="22" />
            </Grid.RowDefinitions>

            <TabControl
                x:Name="QueryTabs"
                Grid.Row="1"
                ItemsSource="{Binding Tabs}"
                SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                VirtualizingPanel.IsVirtualizing="False"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TabViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="4,0"
                                VerticalAlignment="Center"
                                Text="{Binding Title}" />
                            <Button
                                Width="16"
                                Height="16"
                                Margin="6,0,0,0"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="Close tab">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontWeight="Bold"
                                                            Foreground="Gray"
                                                            Text="✕" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlus}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type local:TabViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>
                            <avalon:TextEditor
                                x:Name="QueryEditor"
                                Grid.Row="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                behaviors:SqlHighlightingBehavior.EnableSqlHighlighting="True"
                                behaviors:AvalonEditBehaviors.CaretOffset="{Binding CaretOffset, Mode=TwoWay}"
                                behaviors:AvalonEditBehaviors.EditorText="{Binding EditorText, Mode=TwoWay}"
                                behaviors:AvalonEditBehaviors.IsModified="{Binding IsModified, Mode=TwoWay}"
                                behaviors:AvalonEditBehaviors.SelectionLength="{Binding SelectionLength, Mode=TwoWay}"
                                behaviors:AvalonEditBehaviors.SelectionStart="{Binding SelectionStart, Mode=TwoWay}"
                                behaviors:AvalonEditBehaviors.ShowCompletionCommand="{Binding ShowCompletionCommand}"
                                ShowLineNumbers="True"
                                SyntaxHighlighting="SQL" />

                            <!--  Splitter between editor and results (placed at parent grid row 1)  -->
                            <GridSplitter
                                Grid.Row="1"
                                Height="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#FFECECEC"
                                ShowsPreview="True" />

                            <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedResultTabIndex, Mode=TwoWay}">
                                <TabItem Header="Grid">
                                    <controls:ResultGrid DataContext="{Binding ResultGridViewModel}" />
                                </TabItem>
                                <TabItem Header="Text">
                                    <controls:ResultTextView QueryResult="{Binding LastResult}" />
                                </TabItem>
                                <TabItem Header="Parameters">
                                    <controls:ParametersView />
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <StatusBar Grid.Row="2">
                <StatusBarItem Content="Ready" />
                <StatusBarItem>
                    <TextBlock Text="{Binding CursorText}" />
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding ElapsedText}" />
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</UserControl>
