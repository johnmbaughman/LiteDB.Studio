{
  "LiteDb": {
    "MaxRows": 1000
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Debug", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" } },
      { "Name": "Debug" },
      { "Name": "File", "Args": { "path": "%LOCALAPPDATA%\\Temp\\LiteDB.Studio\\log-.txt", "rollingInterval": "Day", "retainedFileCountLimit": 30, "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  }
}